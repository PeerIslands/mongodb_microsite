{
  "name": "mongodb-microsite-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run copy-config",
    "copy-config": "cp staticwebapp.config.json build/staticwebapp.config.json",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@toast-ui/react-editor": "^3.2.3",
    "axios": "^1.6.2",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-phone-number-input": "^3.4.14",
    "react-router-dom": "^6.20.0",
    "swiper": "^12.0.3"
  },
  "overrides": {
    "@toast-ui/react-editor": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "dompurify": "^3.3.1",
    "esbuild": "^0.27.2",
    "rollup": "^4.28.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.1.1",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "typescript": "^5.2.2",
    "vite": "^5.4.11"
  }
}
